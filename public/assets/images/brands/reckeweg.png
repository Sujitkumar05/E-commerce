<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 220 90" width="220" height="90">
    <g transform="translate(16, 12)">
      <!-- German Red Rhombus Emblem with Cross -->
      <g transform="translate(6, 6)">
        <polygon points="20,0 40,20 20,40 0,20" fill="#c62828"/>
        <!-- White Stylized Flask / Monogram inside -->
        <rect x="17" y="10" width="6" height="20" fill="#ffffff" rx="1"/>
        <rect x="10" y="17" width="20" height="6" fill="#ffffff" rx="1"/>
        <circle cx="20" cy="20" r="4" fill="#c62828"/>
      </g>
      <!-- Wordmark -->
      <text x="54" y="26" font-family="'Arial', 'Helvetica', sans-serif" font-size="19" font-weight="800" fill="#1a237e" letter-spacing="-0.3">Dr. Reckeweg</text>
      <text x="55" y="40" font-family="'Segoe UI', sans-serif" font-size="9" font-weight="700" fill="#c62828" letter-spacing="1.5">BENSHEIM · GERMANY</text>
      <text x="55" y="52" font-family="'Segoe UI', sans-serif" font-size="8" font-weight="600" fill="#555" letter-spacing="0.5">Original Homeopathy</text>
    </g>
  </svg>